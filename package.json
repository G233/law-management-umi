{
  "private": true,
  "name": "law-management-umi",
  "scripts": {
    "start": "w2 add .whistle.js --force && max dev",
    "build": "npm run fnBuild &&  npm run fnDeployPrd  && max build ",
    "postinstall": "max setup",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "fnBuild": "esbuild functions/src/index.ts --bundle --outdir=functions/fn_call  --platform=node --target=node10.4 --minify  ",
    "fnDeployDev": " npm run fnBuild  && pnpm tcb fn deploy fn_call --force --config-file cloudbaserc.dev.json ",
    "fnDeployPrd": " npm run fnBuild && tcb fn deploy fn_call --force --config-file cloudbaserc.prd.json",
    "test": "max test",
    "test:coverage": "max test --coverage"
  },
  "engines": {
    "node": "16",
    "pnpm": ">=7.0.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^4.6.2",
    "@ant-design/pro-card": "^1.10.5",
    "@ant-design/pro-form": "^1.16.2",
    "@ant-design/pro-layout": "^6.5.0",
    "@ant-design/pro-table": "^2.30.6",
    "@babel/runtime": "^7.14.0",
    "@cloudbase/cli": "^2.5.0",
    "@cloudbase/js-sdk": "^1.4.0",
    "@cloudbase/node-sdk": "^2.5.0",
    "@umijs/max": "^4.3.35",
    "ahooks": "^2.10.0",
    "antd": "^4.24.16",
    "classnames": "^2.3.1",
    "moment": "^2.29.1",
    "rc-util": "^5.13.1",
    "react-helmet-async": "^1.0.7",
    "uuid": "^8.3.2",
    "wx-server-sdk": "^2.4.0"
  },
  "devDependencies": {
    "@types/classnames": "^2.2.11",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "esbuild": "^0.25.12",
    "lint-staged": "^10.0.7",
    "prettier": "^2.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "yorkie": "^2.0.0"
  }
}