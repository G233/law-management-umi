{
  "private": true,
  "name": "law-management-umi",
  "scripts": {
    "start": "w2 add .whistle.js --force && max dev",
    "build": "pnpm run fnBuild && max build",
    "build:function": "pnpm run fnBuild",
    "postinstall": "max setup",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "fnBuild": "esbuild functions/src/index.ts --bundle --outdir=functions/fn_call --platform=node --target=node20 --minify",
    "fnDeployDev": "pnpm run fnBuild && tcb fn deploy fn_call --force --config-file cloudbaserc.dev.json",
    "fnDeployPrd": "pnpm run fnBuild && tcb fn deploy fn_call --force --config-file cloudbaserc.prd.json",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src functions/src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src functions/src --fix",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@ant-design/pro-card": "^2.9.1",
    "@ant-design/pro-form": "^2.30.1",
    "@ant-design/pro-layout": "^7.21.1",
    "@ant-design/pro-table": "^3.16.5",
    "@babel/runtime": "^7.26.0",
    "@cloudbase/cli": "^2.5.0",
    "@cloudbase/js-sdk": "^2.32.0",
    "@cloudbase/node-sdk": "^2.11.0",
    "@umijs/max": "^4.3.35",
    "ahooks": "^3.8.1",
    "antd": "^5.22.3",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.13",
    "rc-util": "^5.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "uuid": "^11.0.3",
    "wx-server-sdk": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitest/coverage-v8": "^2.1.6",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.6",
    "yorkie": "^2.0.0"
  }
}
